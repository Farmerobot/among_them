# LLM Backend Selection: ollama, mlx, openrouter
LLM_BACKEND=ollama

# Model name (defaults to backend-specific default if not set)
# Ollama default: deepseek-r1:1.5b
# MLX default: mlx-community/DeepSeek-R1-Distill-Qwen-14B-4bit
# OpenRouter default: deepseek/deepseek-r1:free
MODEL_NAME="hf.co/Farmerobot/deepseek-r1-among-them-gguf"

# API Keys (only needed for respective backends)
OPENROUTER_API_KEY=your_openrouter_api_key
PUT_JWT=your_put_jwt
STATE_FILE=data/game_state.json
HUGGINGFACE_API_KEY=your_huggingface_api_key