# LLM Backend Selection: ollama, mlx, openrouter
LLM_BACKEND=ollama

# Model name (defaults to backend-specific default if not set)
# Ollama default: deepseek-r1:14b
# MLX default: mlx-community/DeepSeek-R1-Distill-Qwen-14B-4bit
# OpenRouter default: deepseek/deepseek-r1:free
MODEL_NAME=deepseek-r1:14b

# API Keys
# For OpenRouter backend (optional, only needed if using openrouter backend)
OPENROUTER_API_KEY=your_openrouter_api_key

# For OpenAI (optional, only needed for trace_analyzer.py script)
OPENAI_API_KEY=your_openai_api_key

# Game state file location (optional, defaults to data/game_state.json)
STATE_FILE=data/game_state.json